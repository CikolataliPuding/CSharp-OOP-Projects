<Window x:Class="MLMatematikCozucu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MLMatematikCozucu"
        mc:Ignorable="d"
        Title="ML Matematik Çözücü" Height="650" Width="1100" MinHeight="600" MinWidth="980">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst başlık -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="ML Matematik Çözücü" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Görseldeki matematiksel ifadeyi OCR ile oku, temizle ve sonucu hesapla."/>
                </StackPanel>

                <TextBlock x:Name="TxtDurum"
                           DockPanel.Dock="Right"
                           Text=""
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- SOL: Görsel önizleme + butonlar -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Görsel önizleme alanı -->
                <Border Background="{StaticResource Surface2Brush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="ImgOnizleme" Stretch="Uniform" Margin="10"/>
                        <TextBlock x:Name="TxtOnizlemeBos"
                                   Text="Henüz görsel yüklenmedi&#x0a;(.png / .jpg)"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Butonlar -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <Button x:Name="BtnGorselYukle" Content="Görsel Yükle" Click="BtnGorselYukle_Click"/>
                    <Button x:Name="BtnAnalizEt"
                            Margin="0,10,0,0"
                            Content="Analiz Et ve Çöz"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnAnalizEt_Click"/>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionStyle}"
                               Text="İpucu: Fotoğrafta mümkünse yalnızca işlem olsun (örnek: 25 + 10 / 2)."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SAĞ: Tespit edilen işlem + sonuç -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tespit Edilen İşlem" FontSize="16" FontWeight="SemiBold"/>
                <Border Grid.Row="1" Margin="0,10,0,18" Background="{StaticResource Surface2Brush}"
                        CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                    <TextBlock x:Name="TxtTespitEdilenIslem"
                               Text="—"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Row="2" Text="Sonuç" FontSize="16" FontWeight="SemiBold"/>
                <Border Grid.Row="3" Margin="0,10,0,0" Background="{StaticResource Surface2Brush}"
                        CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="TxtSonuc" Text="—" Style="{StaticResource BigValueStyle}"/>

                        <!-- Hata/uyarı metni -->
                        <TextBlock x:Name="TxtUyari"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource DangerBrush}"
                                   Text=""
                                   Visibility="Collapsed"/>

                        <!-- İstersen hocaya gösterirken faydalı: ham OCR metni -->
                        <Expander Margin="0,14,0,0" Header="Ham OCR Metni (debug)" Foreground="{StaticResource SubTextBrush}">
                            <TextBlock x:Name="TxtHamOcr" Text="" Style="{StaticResource CaptionStyle}"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
